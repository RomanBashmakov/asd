

#include "KSZ9567S.h"

char KSZ9567_RegReadByte(T_KSZ9567S *hub, uint16_t addr)
{

  char ret = 0;

  TWI_start(&hub->twi);
//  printf ("rd %X %X %d\n", Addr, Reg, TWI_send_byte(Addr));
  TWI_send_byte(&hub->twi, 0xBE);
  TWI_send_byte(&hub->twi, addr >> 8);
  TWI_send_byte(&hub->twi, addr & 0xFF);
  TWI_release_scl(&hub->twi);
  TWI_start(&hub->twi);
  TWI_send_byte(&hub->twi, 0xBF);
  /*int i = 0;
  for (i = 0; i < len - 1; i++){
    Data[i] = TWI_read_data(&hub->twi, 1);
    printf ("%X \n", Data[i]);
  }*/
  ret = TWI_read_data(&hub->twi, 0);
  TWI_release_scl(&hub->twi);


  return ret;


}



void KSZ9567_RegWriteByte(T_KSZ9567S *hub, uint16_t addr, uint8_t byte)
{


  //char tmp = 1;

  TWI_start(&hub->twi);
//  printf ("rd %X %X %d\n", Addr, Reg, TWI_send_byte(Addr));
  TWI_send_byte(&hub->twi, 0xBE);
  //printf("tmp = %d\n", tmp);
  TWI_send_byte(&hub->twi, addr >> 8);
  //printf("tmp = %d\n", tmp);
  TWI_send_byte(&hub->twi, addr & 0xFF);
  //printf("tmp = %d\n", tmp);

  TWI_send_byte(&hub->twi, byte);
  //printf("tmp = %d\n", tmp);
  /*int i = 0;
  for (i = 0; i < len - 1; i++){
    Data[i] = TWI_read_data(&hub->twi, 1);
    printf ("%X \n", Data[i]);
  }*/
  TWI_stop(&hub->twi);




}



uint16_t KSZ9567_SgmiiRegRead(T_KSZ9567S *hub, uint32_t addr)
{
  uint16_t ret = 0;

  char *da = (char*)&addr;

  // write address
  TWI_start(&hub->twi);
  TWI_send_byte(&hub->twi, 0xBE);
  TWI_send_byte(&hub->twi, 0x72);
  TWI_send_byte(&hub->twi, 0x00);

  TWI_send_byte(&hub->twi, da[3]);
  TWI_send_byte(&hub->twi, da[2]);
  TWI_send_byte(&hub->twi, da[1]);
  TWI_send_byte(&hub->twi, da[0]);
  TWI_stop(&hub->twi);


  // read data
  TWI_start(&hub->twi);
  TWI_send_byte(&hub->twi, 0xBE);
  TWI_send_byte(&hub->twi, 0x72);
  TWI_send_byte(&hub->twi, 0x06);
  TWI_release_scl(&hub->twi);
  TWI_start(&hub->twi);
  TWI_send_byte(&hub->twi, 0xBF);
  ret = (uint16_t)TWI_read_data(&hub->twi, 1) << 8;
  ret |= TWI_read_data(&hub->twi, 0);
  TWI_release_scl(&hub->twi);




  return ret;
}



void KSZ9567_SgmiiRegWrite(T_KSZ9567S *hub, uint32_t addr, uint16_t data)
{
  char *da = (char*)&addr;

  // write address
  TWI_start(&hub->twi);
  TWI_send_byte(&hub->twi, 0xBE);
  TWI_send_byte(&hub->twi, 0x72);
  TWI_send_byte(&hub->twi, 0x00);

  TWI_send_byte(&hub->twi, da[3]);
  TWI_send_byte(&hub->twi, da[2]);
  TWI_send_byte(&hub->twi, da[1]);
  TWI_send_byte(&hub->twi, da[0]);
  TWI_stop(&hub->twi);


  // write data
  TWI_start(&hub->twi);
  TWI_send_byte(&hub->twi, 0xBE);
  TWI_send_byte(&hub->twi, 0x72);
  TWI_send_byte(&hub->twi, 0x06);
  TWI_send_byte(&hub->twi, data >> 8);
  TWI_send_byte(&hub->twi, data & 0xFF);
  TWI_stop(&hub->twi);


}


